# Адрес трекера (без /admin)
KEITARO_URL=https://tlgk.host
# Ключ из админки Keitaro: Обслуживание → Admin API
KEITARO_API_KEY=
# База обёртки. По умолчанию SQLite-файл рядом с проектом; Postgres: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./wrapper.db
# Обязательный префикс названий кампаний (пусто — без проверки)
CAMPAIGN_PREFIX=test_ibrokhimzoda_
# Куда отправлять посетителей из выбранной страны
FALLBACK_URL=https://google.com
